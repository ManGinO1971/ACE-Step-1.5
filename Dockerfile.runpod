ARG CUDA_VERSION=12.8.1
ARG PYTHON_VERSION=3.11

FROM nvidia/cuda:${CUDA_VERSION}-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

RUN apt-get update && apt-get install -y --no-install-recommends \
        software-properties-common build-essential git curl wget \
        libsndfile1 libsndfile1-dev ffmpeg libffi-dev libssl-dev \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        python3.11 python3.11-dev python3.11-venv \
        python3.10 python3.10-dev python3.10-venv \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /app
COPY . /app/

# Re-resolve the lock before syncing: a new dependency (demucs, for the
# background-stem overlay feature) was added to pyproject.toml without a
# matching uv.lock regeneration here, since that needs the PyTorch wheel
# index which isn't reachable from every environment that edits this file.
# `uv lock` on the actual build machine (which does have that access) keeps
# `--frozen` meaningful again instead of failing on a stale lockfile.
RUN uv lock
RUN uv sync --frozen --no-dev --python python3.11

# Separate, isolierte Python-3.10-venv NUR fuer die RVC-Stimmwechsel-
# Abhaengigkeiten von rvc_convert_step.py (fairseq==0.12.2, rvc-python,
# hydra-core==1.0.7, omegaconf==2.0.6). Per isoliertem Test bestaetigt
# (8. Okt, ohne jede GPU-Erzeugung): dieser exakte, von rvc-python
# verlangte Stack importiert unter Python 3.11 (der Hauptumgebung oben)
# NICHT - hydra-core 1.0.7 nutzt ein Dataclass-Feld mit "mutable default",
# das Python 3.11 strikter prueft als 3.10 und das deshalb beim Import von
# "fairseq" (initialisiert beim Laden automatisch Hydra) mit einem
# ValueError abbricht. fairseq selbst baut unter 3.11 einwandfrei - das
# urspruenglich vermutete "fehlendes version.txt"-Problem betraf nur die
# veraltete PyPI-Version 0.12.1, nicht die hier noetige 0.12.2. Deshalb
# bewusst eine zweite, komplett getrennte venv statt die Hauptumgebung
# herunterzustufen - siehe _HIELTECH_RVC_VENV_PYTHON in
# runpod_entrypoint.py, die diese venv gezielt fuer genau diesen einen
# Schritt per subprocess aufruft.
#
# torch/torchaudio kommen hier bewusst aus dem CPU-Index (nicht dem
# riesigen CUDA-Torch der Hauptumgebung) - rvc_convert_step.py instanziiert
# RVCInference() ohnehin fest mit device="cpu" (unveraendert von der
# Mac-Version uebernommen), ein zweiter mehrere GB grosser CUDA-Torch waere
# hier reine Platz-/Build-Zeit-Verschwendung.
RUN python3.10 -m venv /opt/acestep_rvc_venv \
    && /opt/acestep_rvc_venv/bin/pip install --no-cache-dir "pip==24.0" \
    && /opt/acestep_rvc_venv/bin/pip install --no-cache-dir \
        --index-url https://download.pytorch.org/whl/cpu \
        --extra-index-url https://pypi.org/simple \
        "numpy<=1.23.5" "omegaconf==2.0.6" "hydra-core==1.0.7" \
        "fairseq==0.12.2" "rvc-python==0.1.5"

RUN mkdir -p /app/checkpoints /app/output

ENV TOKENIZERS_PARALLELISM=false
ENV ACESTEP_API_HOST=0.0.0.0

EXPOSE 5000

CMD ["sh", "-c", "rm -rf /app/checkpoints && ln -s /runpod-volume /app/checkpoints && uv run python runpod_entrypoint.py"]
